{
    "表示する": {
        "prefix": "表示",
        "body": [
            "表示する「${1:表示内容}」"
        ],
        "description": "文字列や値を表示します"
    },

    "入力する": {
        "prefix": "入力",
        "body": [
            "入力する「${1:変数名}」"
        ],
        "description": "ユーザーから入力を受け取ります"
    },

    "変数に入れる": {
        "prefix": "変数",
        "body": [
            "変数「${1:名前}」に入れる ${2:値}"
        ],
        "description": "変数に値を代入します"
    },

    "計算する": {
        "prefix": "計算",
        "body": [
            "計算する ${1:式}"
        ],
        "description": "計算結果を表示します"
    },

    "待つ": {
        "prefix": "待つ",
        "body": [
            "待つ ${1:秒数}"
        ],
        "description": "指定した秒数だけ待機します"
    },

    "もし": {
        "prefix": "もし",
        "body": [
            "もし ${1:条件}",
            "",
            "    ${2:処理}",
            "",
            "終わり"
        ],
        "description": "条件分岐を作成します"
    },

    "それ以外": {
        "prefix": "それ以外",
        "body": [
            "それ以外",
            "",
            "    ${1:処理}"
        ],
        "description": "条件分岐のそれ以外を作成します"
    },

    "繰り返す": {
        "prefix": "繰り返す",
        "body": [
            "繰り返す ${1:5}回",
            "",
            "    ${2:処理}",
            "",
            "終わり"
        ],
        "description": "指定回数の繰り返しを作成します"
    },

    "終わり": {
        "prefix": "終わり",
        "body": [
            "終わり"
        ],
        "description": "ブロックを終了します"
    },

    "抜ける": {
        "prefix": "抜ける",
        "body": [
            "抜ける"
        ],
        "description": "現在の繰り返しを終了します"
    },

    "増やす": {
        "prefix": "増やす",
        "body": [
            "増やす ${1:変数} ${2:数値}"
        ],
        "description": "変数の値を増やします"
    },

    "減らす": {
        "prefix": "減らす",
        "body": [
            "減らす ${1:変数} ${2:数値}"
        ],
        "description": "変数の値を減らします"
    },

    "掛ける": {
        "prefix": "掛ける",
        "body": [
            "掛ける ${1:変数} ${2:数値}"
        ],
        "description": "変数に数値を掛けます"
    },

    "割る": {
        "prefix": "割る",
        "body": [
            "割る ${1:変数} ${2:数値}"
        ],
        "description": "変数を数値で割ります"
    },

    "余り": {
        "prefix": "余り",
        "body": [
            "余り ${1:変数} ${2:数値}"
        ],
        "description": "割り算の余りを求めます"
    },

    "数字にする": {
        "prefix": "数字にする",
        "body": [
            "数字にする「${1:文字列}」"
        ],
        "description": "値を数字に変換します"
    },

    "文字にする": {
        "prefix": "文字にする",
        "body": [
            "文字にする ${1:値}"
        ],
        "description": "値を文字列に変換します"
    },

    "文字をつなぐ": {
        "prefix": "文字をつなぐ",
        "body": [
            "文字をつなぐ「${1:文字列1}」「${2:文字列2}」"
        ],
        "description": "2つの文字列をつなぎます"
    },

    "大文字にする": {
        "prefix": "大文字にする",
        "body": [
            "大文字にする「${1:文字列}」"
        ],
        "description": "文字列を大文字にします"
    },

    "小文字にする": {
        "prefix": "小文字にする",
        "body": [
            "小文字にする「${1:文字列}」"
        ],
        "description": "文字列を小文字にします"
    },

    "リストを作る": {
        "prefix": "リスト",
        "body": [
            "リスト「${1:名前}」を作る"
        ],
        "description": "リストを作成します"
    },

    "リストに追加する": {
        "prefix": "リスト追加",
        "body": [
            "リスト「${1:名前}」に「${2:値}」を追加する"
        ],
        "description": "リストに値を追加します"
    },

    "リストから削除する": {
        "prefix": "リスト削除",
        "body": [
            "リスト「${1:名前}」から「${2:値}」を削除する"
        ],
        "description": "リストから値を削除します"
    },

    "リストから取り出す": {
        "prefix": "リスト取得",
        "body": [
            "リスト「${1:名前}」から取り出す ${2:0}"
        ],
        "description": "リストから値を取り出します"
    },

    "リストの長さ": {
        "prefix": "リスト長さ",
        "body": [
            "リスト「${1:名前}」の長さ"
        ],
        "description": "リストの長さを取得します"
    },

    "最大": {
        "prefix": "最大",
        "body": [
            "最大 ${1:10}, ${2:20}, ${3:30}"
        ],
        "description": "最大値を求めます"
    },

    "最小": {
        "prefix": "最小",
        "body": [
            "最小 ${1:10}, ${2:20}, ${3:30}"
        ],
        "description": "最小値を求めます"
    },

    "絶対値": {
        "prefix": "絶対値",
        "body": [
            "絶対値 ${1:-100}"
        ],
        "description": "絶対値を求めます"
    },

    "四捨五入": {
        "prefix": "四捨五入",
        "body": [
            "四捨五入 ${1:3.14}"
        ],
        "description": "数値を四捨五入します"
    },

    "存在する": {
        "prefix": "存在する",
        "body": [
            "存在する ${1:変数}"
        ],
        "description": "変数などが存在するか確認します"
    }
}